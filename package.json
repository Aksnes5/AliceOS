{
  "name": "aliceos",
  "version": "1.0.0",
  "description": "A simulated operating system environment",
  "main": "src/kernel/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.aliceos.app",
    "productName": "AliceOS",
    "win": {
      "target": [
        "portable"
      ]
    },
    "directories": {
      "output": "release"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  }
}
